# Dantola Dental Clinic - static site (Apache/LiteSpeed on Hostinger)
# The whole repository is published into public_html, so these rules also keep the
# repo's own sources, tooling and config off the web.

Options -Indexes
DirectoryIndex index.html

ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS. Hostinger's hPanel "Force HTTPS" toggle already does this once SSL is
  # installed; enabling both can loop behind a TLS-terminating proxy, so it ships off.
  # Uncomment ONLY if hPanel's toggle is unavailable.
  # RewriteCond %{HTTPS} !=on
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Never serve dot-files (.git, .env, ...) but keep ACME/SSL validation reachable
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # Never serve the repository's own sources, tooling or dependencies
  RewriteRule ^(src|tools|node_modules)/ - [F,L]

  # Clean URLs: /services -> services.html (internal, no redirect, no loop)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # A trailing slash on a page name resolves to the page, never to a directory listing
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} ^/([a-z0-9-]+)/$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/%1\.html -f
  RewriteRule ^([a-z0-9-]+)/$ /$1.html [R=301,L]
</IfModule>

<IfModule mod_alias.c>
  # RedirectMatch is mod_alias, not mod_rewrite, so it gets its own guard
  RedirectMatch 404 ^/(package\.json|package-lock\.json|tailwind\.config\.js|README\.md|DEPLOY\.md|\.gitattributes|\.gitignore|SITE-DOMAIN\.txt)$
  RedirectMatch 404 ^/(src|tools|node_modules)/
  # the Tailwind source sheet is not a web asset - only the compiled tailwind.css is
  RedirectMatch 404 ^/assets/css/input\.css$
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # HTML is always revalidated: a cached page hides a deploy
  ExpiresByType text/html "access plus 0 seconds"
  # the stylesheet/script carry ?v=<hash> query strings from the build
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # config.js is the edit-without-rebuild file: it must never be cached
  <FilesMatch "^config\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_rewrite.c>
  # /index.html and /home both resolve to the real homepage
  RewriteRule ^index\.html$ / [R=301,L]
</IfModule>

# If anything here breaks the site (500), renaming this file to .htaccess.off restores it.
